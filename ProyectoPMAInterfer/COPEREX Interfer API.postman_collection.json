      "name": "Autenticacion",
      "item": [
        {
          "name": "Iniciar Sesion",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('TOKEN', res.data.token);",
                  "    console.log('Token de administrador guardado correctamente.');",
                  "} else {",
                  "    console.warn('No se pudo guardar el token. Verifica las credenciales.');",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"jregil0re@gmail.com\",\n    \"password\": \"Admin1234!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:3005/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3005",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Endpoint publico. No requiere token.\n\nInicia sesion como administrador. Al ejecutar este request correctamente, el token JWT se guarda automaticamente en la variable TOKEN y todos los demas endpoints lo usaran de forma automatica en el campo Authorization como Bearer Token."
          },
          "response": []
